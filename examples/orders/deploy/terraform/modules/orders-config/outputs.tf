# The pod's volumes, each { name, config_map, secret, csi, image } with exactly one kind set, in
# the kubernetes provider's volume block shape. Use it in a dynamic "volume" block (README.md).
output "kubernetes_volumes" {
  description = "The pod's volumes for file inputs and overlays, in the contract's order."
  value       = local.kubernetes_volumes

  precondition {
    condition     = var.discounts == null ? true : length([for k, s in var.discounts : k if s != null]) == 1
    error_message = "discounts: set exactly one of inline, config_map, secret, csi, image or injected (Terraform ignores certificate here: a config input cannot take them)"
  }

  precondition {
    condition     = var.discounts == null ? true : (var.discounts.injected == null ? true : can(regex("^[a-z0-9]([-a-z0-9.]{0,61}[a-z0-9])?$", var.discounts.injected.provider)))
    error_message = "discounts: injected.provider must name the injector as a lowercase label, such as bank-vaults"
  }

  precondition {
    condition     = var.discounts == null ? true : (var.discounts.inline == null ? true : substr(jsonencode(var.discounts.inline), 0, 1) == "\"" || contains(["{", "["], substr(jsonencode(var.discounts.inline), 0, 1)))
    error_message = "discounts: inline content must be text, or an object or a list to write as yaml"
  }

  precondition {
    condition     = var.discounts == null ? true : (var.discounts.inline == null ? true : !(substr(jsonencode(var.discounts.inline), 0, 1) == "\"") ? true : can(yamldecode(var.discounts.inline)))
    error_message = "discounts: inline content is not valid yaml"
  }

  precondition {
    condition     = var.discounts == null ? true : (var.discounts.image == null ? true : var.discounts.image.pull_policy == null ? true : contains(["Always", "IfNotPresent", "Never"], var.discounts.image.pull_policy))
    error_message = "discounts: image.pull_policy ${try(format("%v", jsonencode(var.discounts.image.pull_policy)), "")} is not one of Always, IfNotPresent, Never"
  }

  precondition {
    condition     = var.serving-tls == null ? true : length([for k, s in var.serving-tls : k if s != null]) == 1
    error_message = "serving-tls: set exactly one of secret, certificate, csi or injected (Terraform ignores inline, config_map or image here: a secret file comes from a secret store)"
  }

  precondition {
    condition     = var.serving-tls == null ? true : (var.serving-tls.injected == null ? true : can(regex("^[a-z0-9]([-a-z0-9.]{0,61}[a-z0-9])?$", var.serving-tls.injected.provider)))
    error_message = "serving-tls: injected.provider must name the injector as a lowercase label, such as bank-vaults"
  }

  precondition {
    condition     = var.serving-tls == null ? true : (var.serving-tls.secret == null ? true : var.serving-tls.secret.key == null)
    error_message = "serving-tls: a tls input mounts the whole Secret; remove secret.key"
  }

  precondition {
    condition     = var.serving-tls == null ? true : (var.serving-tls.certificate == null ? true : var.serving-tls.certificate.dns_names == null ? true : contains(var.serving-tls.certificate.dns_names, "orders.example.com") || contains(var.serving-tls.certificate.dns_names, "*.example.com"))
    error_message = "serving-tls: certificate does not cover orders.example.com"
  }

  precondition {
    condition     = var.serving-tls == null ? true : (var.serving-tls.certificate == null ? true : var.serving-tls.certificate.duration == null ? true : can(regex("^([0-9]+(ns|us|ms|s|m|h))+$", var.serving-tls.certificate.duration)))
    error_message = "serving-tls: certificate.duration ${try(format("%v", jsonencode(var.serving-tls.certificate.duration)), "")} is not a duration such as 1m30s"
  }

  precondition {
    condition     = var.serving-tls == null ? true : (var.serving-tls.certificate == null ? true : var.serving-tls.certificate.renew_before == null ? true : can(regex("^([0-9]+(ns|us|ms|s|m|h))+$", var.serving-tls.certificate.renew_before)))
    error_message = "serving-tls: certificate.renew_before ${try(format("%v", jsonencode(var.serving-tls.certificate.renew_before)), "")} is not a duration such as 1m30s"
  }

  precondition {
    condition     = var.serving-tls == null ? true : (var.serving-tls.certificate == null ? true : var.serving-tls.certificate.renew_before == null ? true : !can(regex("^([0-9]+(ns|us|ms|s|m|h))+$", var.serving-tls.certificate.renew_before)) ? true : sum([for p in regexall("([0-9]+)(ns|us|ms|s|m|h)", var.serving-tls.certificate.renew_before) : tonumber(p[0]) * { ns = 1, us = 1000, ms = 1000000, s = 1000000000, m = 60000000000, h = 3600000000000 }[p[1]]]) >= 2592000000000000)
    error_message = "serving-tls: certificate renewBefore ${try(format("%v", var.serving-tls.certificate.renew_before), "")} is less than minRemaining 720h, so the app could see a certificate with too little time left"
  }
}

