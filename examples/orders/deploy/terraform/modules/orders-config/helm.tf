    condition     = var.serving-tls == null ? true : (var.serving-tls.secret == null ? true : var.serving-tls.secret.key == null)
    error_message = "serving-tls: a tls input mounts the whole Secret; remove secret.key"
  }

  precondition {
    condition     = var.serving-tls == null ? true : (var.serving-tls.certificate == null ? true : var.serving-tls.certificate.dns_names == null ? true : contains(var.serving-tls.certificate.dns_names, "orders.example.com") || contains(var.serving-tls.certificate.dns_names, "*.example.com"))
    error_message = "serving-tls: certificate does not cover orders.example.com"
  }

  precondition {
    condition     = var.serving-tls == null ? true : (var.serving-tls.certificate == null ? true : var.serving-tls.certificate.duration == null ? true : can(regex("^([0-9]+(ns|us|ms|s|m|h))+$", var.serving-tls.certificate.duration)))
    error_message = "serving-tls: certificate.duration ${try(format("%v", jsonencode(var.serving-tls.certificate.duration)), "")} is not a duration such as 1m30s"
  }

  precondition {
    condition     = var.serving-tls == null ? true : (var.serving-tls.certificate == null ? true : var.serving-tls.certificate.renew_before == null ? true : can(regex("^([0-9]+(ns|us|ms|s|m|h))+$", var.serving-tls.certificate.renew_before)))
    error_message = "serving-tls: certificate.renew_before ${try(format("%v", jsonencode(var.serving-tls.certificate.renew_before)), "")} is not a duration such as 1m30s"
  }

  precondition {
    condition     = var.serving-tls == null ? true : (var.serving-tls.certificate == null ? true : var.serving-tls.certificate.renew_before == null ? true : !can(regex("^([0-9]+(ns|us|ms|s|m|h))+$", var.serving-tls.certificate.renew_before)) ? true : sum([for p in regexall("([0-9]+)(ns|us|ms|s|m|h)", var.serving-tls.certificate.renew_before) : tonumber(p[0]) * { ns = 1, us = 1000, ms = 1000000, s = 1000000000, m = 60000000000, h = 3600000000000 }[p[1]]]) >= 2592000000000000)
    error_message = "serving-tls: certificate renewBefore ${try(format("%v", var.serving-tls.certificate.renew_before), "")} is less than minRemaining 720h, so the app could see a certificate with too little time left"
  }
}
