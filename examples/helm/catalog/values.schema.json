                {
                  "type": "string",
                  "pattern": "^([0-9]+(ns|us|ms|s|m|h))+$"
                },
                {
                  "type": "object",
                  "required": [
                    "configMapKeyRef"
                  ],
                  "additionalProperties": {
                    "type": "null"
                  },
                  "properties": {
                    "configMapKeyRef": {
                      "type": "object",
                      "required": [
                        "name",
                        "key"
                      ],
                      "additionalProperties": true,
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "injected"
                  ],
                  "additionalProperties": {
                    "type": "null"
                  },
                  "properties": {
                    "injected": {
                      "type": "object",
                      "required": [
                        "provider"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "podAnnotations": {
                          "description": "Pod annotations the injector needs; {input}, and for a file {path}, {dir} and {file}, are expanded.",
                          "type": "object",
                          "additionalProperties": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "podLabels": {
                          "description": "Pod labels the injector needs; placeholders as for podAnnotations.",
                          "type": "object",
                          "additionalProperties": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "provider": {
                          "type": "string",
                          "pattern": "^[a-z0-9]([-a-z0-9.]{0,61}[a-z0-9])?$"
                        },
                        "ref": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                {
                  "type": "null",
                  "description": "Unset."
                }
              ]
