                {
                  "type": "object",
                  "required": [
                    "configMapKeyRef"
                  ],
                  "additionalProperties": {
                    "type": "null"
                  },
                  "properties": {
                    "configMapKeyRef": {
                      "type": "object",
                      "required": [
                        "name",
                        "key"
