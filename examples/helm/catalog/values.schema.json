{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "docuconf": {
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "values"
              ],
              "properties": {
                "values": {
                  "required": [
                    "CATALOG__SEARCH__URL"
                  ]
                }
              }
            },
            {
              "required": [
                "overlays"
              ],
              "properties": {
                "overlays": {
                  "required": [
                    "platform"
                  ],
                  "properties": {
                    "platform": {
                      "required": [
                        "CATALOG__SEARCH__URL"
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      "type": "object",
      "description": "Inputs for catalog-api, checked against its docuconf contract.",
      "additionalProperties": false,
      "properties": {
        "global": {
          "description": "Set by Helm for the docuconf library chart; ignored."
        },
        "values": {
          "type": "object",
          "description": "Environment variables, as typed values.",
          "additionalProperties": false,
          "properties": {
            "CATALOG__CACHETTL": {
              "description": "How long catalog pages are cached",
