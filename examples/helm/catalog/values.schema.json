                        "provider": {
                          "type": "string",
                          "pattern": "^[a-z0-9]([-a-z0-9.]{0,61}[a-z0-9])?$"
                        },
                        "ref": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
