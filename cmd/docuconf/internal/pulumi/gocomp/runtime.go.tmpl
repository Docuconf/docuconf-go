			return []entry{{name, marshal(items)}}
		case "indexed":
			out := make([]entry, len(items))
			for i, it := range items {
				out[i] = entry{fmt.Sprintf("%s__%d", name, i), scalar(it)}
			}
			return out
		}
		sep := ","
		if v.Separator != nil {
			sep = *v.Separator
		}
		parts := make([]string, len(items))
		for i, it := range items {
			parts[i] = scalar(it)
		}
		return []entry{{name, strings.Join(parts, sep)}}
	case "duration":
		return []entry{{name, renderDuration(scalar(x), v.Encoding)}}
	}
	return []entry{{name, scalar(x)}}
}

// esc doubles every $: Kubernetes expands $(VAR) in env values and reduces
// $$ to $.
func esc(s string) string { return strings.ReplaceAll(s, "$", "$$") }

// ---- Rendering (#Render), on resolved arguments ----

type resolved struct {
	kind   string
	fields any
}

type rendered struct {
	env             []map[string]any
	volumes         []map[string]any
	volumeMounts    []map[string]any
	configMaps      []ConfigMapSpec
	restartTriggers []RestartTrigger
	podAnnotations  map[string]string
	podLabels       map[string]string
}

// ConfigMapSpec is a ConfigMap the program declares, in the workload's namespace.
type ConfigMapSpec struct {
	Name      string
	Data      map[string]string
	Immutable bool
}

// RestartTrigger is a ConfigMap, Secret or SecretProviderClass whose change
// must restart the pods.
type RestartTrigger struct {
	Kind string
	Name string
}

// Binding says whether an input is set, and by which source. docuconf lint reads it.
type Binding struct {
	Set    bool   `json:"set"`
	Source string `json:"source"`
}

func obj(x any) map[string]any { m, _ := x.(map[string]any); return m }

func str(m map[string]any, k string) string { s, _ := m[k].(string); return s }

func renderVar(name string, v contractVar, r resolved) []map[string]any {
	switch r.kind {
	case "injected":
		if ref := str(obj(r.fields), "ref"); ref != "" {
			return []map[string]any{{"name": name, "value": esc(ref)}}
		}
		return nil
	case "value":
		var out []map[string]any
		for _, e := range wireEntries(name, v, r.fields) {
			out = append(out, map[string]any{"name": e.name, "value": esc(e.value)})
		}
		return out
	}
	return []map[string]any{{"name": name, "valueFrom": map[string]any{r.kind: r.fields}}}
}

func mountDir(f contractFile) string {
	if f.Type == "tls" {
		return f.Path
	}
	return path.Dir(f.Path)
}

// inlineContent is the text an inline source puts in the file (#InlineContent).
func inlineContent(f contractFile, inline any) string {
	if s, ok := inline.(string); ok {
		return s
	}
	switch f.Format {
	case "json":
		return marshal(inline)
	case "toml":
		b, _ := toml.Marshal(inline)
		return string(b)
	}
	return yamlString(inline)
}

func yamlString(x any) string {
	var b bytes.Buffer
	enc := yaml.NewEncoder(&b)
	enc.SetIndent(2)
	enc.Encode(x)
	enc.Close()
	return b.String()
}

func hash10(s string) string {
	sum := sha256.Sum256([]byte(s))
	return hex.EncodeToString(sum[:])[:10]
}

type fileParts struct {
	env, volumes, volumeMounts []map[string]any
	configMaps                 []ConfigMapSpec
	restartTriggers            []RestartTrigger
}

func renderFile(service, name string, f contractFile, r resolved) fileParts {
	var out fileParts
	if f.PathEnv != "" {
		out.env = append(out.env, map[string]any{"name": f.PathEnv, "value": esc(f.Path)})
	}
	if r.kind == "injected" {
		return out
	}
	vol := "dc-" + name
	fileName := path.Base(f.Path)
	mode := 0o444
	if f.Secret {
		mode = 0o400
	}
	s := obj(r.fields)
	restart := func(kind, n string) {
		if f.Reload == "restart" {
			out.restartTriggers = append(out.restartTriggers, RestartTrigger{kind, n})
		}
	}
	items := func(key string) []any { return []any{map[string]any{"key": key, "path": fileName}} }
	volume := map[string]any{"name": vol}
	switch r.kind {
	case "inline":
		content := inlineContent(f, r.fields)
		cm := fmt.Sprintf("%s-%s-%s", service, name, hash10(content))
		volume["configMap"] = map[string]any{"name": cm, "defaultMode": mode, "items": items(fileName)}
		out.configMaps = append(out.configMaps, ConfigMapSpec{Name: cm, Data: map[string]string{fileName: content}, Immutable: true})
	case "configMap":
		volume["configMap"] = map[string]any{"name": str(s, "name"), "defaultMode": mode, "items": items(str(s, "key"))}
		restart("ConfigMap", str(s, "name"))
	case "secret":
		sec := map[string]any{"secretName": str(s, "name"), "defaultMode": mode}
		if f.Type != "tls" {
			sec["items"] = items(str(s, "key"))
		}
		volume["secret"] = sec
		restart("Secret", str(s, "name"))
	case "certificate":
		volume["secret"] = map[string]any{"secretName": str(s, "secretName"), "defaultMode": mode}
		restart("Secret", str(s, "secretName"))
	case "image":
		im := map[string]any{"reference": str(s, "reference")}
		if p := str(s, "pullPolicy"); p != "" {
			im["pullPolicy"] = p
		}
		volume["image"] = im
	case "csi":
		spc := str(s, "secretProviderClass")
		volume["csi"] = map[string]any{"driver": str(s, "driver"), "readOnly": true, "volumeAttributes": map[string]any{"secretProviderClass": spc}}
		restart("SecretProviderClass", spc)
	}
	out.volumes = append(out.volumes, volume)
	out.volumeMounts = append(out.volumeMounts, map[string]any{"name": vol, "mountPath": mountDir(f), "readOnly": true})
	return out
}

// overlayNative is a value as an overlay writes it: native types, a
// duration in its encoding (#OverlayData).
func overlayNative(v contractVar, x any) any {
	d, ok := x.(string)
	if v.Type != "duration" || !ok {
		return x
	}
	if v.Encoding == "seconds" {
		ms, _ := durationParts(d)
		if ms%1000 == 0 {
			return ms / 1000
		}
		return float64(ms) / 1000
	}
	return renderDuration(d, v.Encoding)
}

func renderOverlay(c *contract, name string, values map[string]any) (ConfigMapSpec, map[string]any, map[string]any) {
	o := c.overlays[name]
	data := map[string]any{}
	names := make([]string, 0, len(values))
	for n := range values {
		names = append(names, n)
	}
	sort.Strings(names)
	for _, n := range names {
		v := c.vars[n]
		key := v.ConfigKey
		if key == "" {
			key = n
		}
		parts := strings.Split(key, o.KeySeparator)
		at := data
		for _, p := range parts[:len(parts)-1] {
			next, ok := at[p].(map[string]any)
			if !ok {
				next = map[string]any{}
				at[p] = next
			}
			at = next
		}
		at[parts[len(parts)-1]] = overlayNative(v, values[n])
	}
	var content string
	switch o.Format {
	case "json":
		var b bytes.Buffer
		enc := json.NewEncoder(&b)
		enc.SetEscapeHTML(false)
		enc.SetIndent("", "  ")
		enc.Encode(data)
		content = b.String()
	case "yaml":
		content = yamlString(data)
	default:
		b, _ := toml.Marshal(data)
		content = string(b)
	}
	fileName := path.Base(o.Path)
	cm := ConfigMapSpec{Name: fmt.Sprintf("%s-overlay-%s-%s", c.name, name, hash10(content)), Data: map[string]string{fileName: content}, Immutable: true}
	if o.Reload == "watch" {
		cm = ConfigMapSpec{Name: fmt.Sprintf("%s-overlay-%s", c.name, name), Data: cm.Data}
	}
	vol := "dc-overlay-" + name
	return cm,
		map[string]any{"name": vol, "configMap": map[string]any{"name": cm.Name, "defaultMode": 0o444, "items": []any{map[string]any{"key": fileName, "path": fileName}}}},
		map[string]any{"name": vol, "mountPath": path.Dir(o.Path), "readOnly": true}
}

// ---- Pod metadata (#PodMetadata) ----

var (
	placeholderRe   = regexp.MustCompile(`\{(input|path|dir|file)\}`)
	qualifiedRe     = regexp.MustCompile(`^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?[A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?$`)
	qualifiedLenRe  = regexp.MustCompile(`^([^/]{1,253}/)?[^/]+$`)
	labelValueRe    = regexp.MustCompile(`^([A-Za-z0-9]([-A-Za-z0-9_.]{0,61}[A-Za-z0-9])?)?$`)
	providerRe      = regexp.MustCompile(`^[a-z0-9]([-a-z0-9.]{0,61}[a-z0-9])?$`)
	fieldPathRe     = regexp.MustCompile(`^(metadata\.name|metadata\.namespace|metadata\.uid|spec\.nodeName|spec\.serviceAccountName|status\.hostIP|status\.podIP|metadata\.(labels|annotations)\['[^']+'\])$`)
	containerFields = []string{"limits.cpu", "limits.memory", "limits.ephemeral-storage", "requests.cpu", "requests.memory", "requests.ephemeral-storage"}
)

const (
	qualifiedRule = `a Kubernetes qualified name: an optional DNS-subdomain prefix (at most 253 characters) and "/", then at most 63 letters, digits, "-", "_" and ".", starting and ending with a letter or digit`
	labelRule     = `at most 63 letters, digits, "-", "_" and ".", starting and ending with a letter or digit, or empty`
)

type podSource struct {
	input       string // "" for the shared PodMetadata
	file        *contractFile
	annotations [][2]string
	labels      [][2]string
}

func expand(s, input string, f *contractFile) string {
	if input != "" {
		s = strings.ReplaceAll(s, "{input}", input)
	}
	if f != nil {
		s = strings.NewReplacer("{path}", f.Path, "{dir}", mountDir(*f), "{file}", path.Base(f.Path)).Replace(s)
	}
	return s
}

func sortedPairs(m map[string]any, input string, f *contractFile) [][2]string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	out := make([][2]string, 0, len(keys))
	for _, k := range keys {
		out = append(out, [2]string{expand(k, input, f), expand(scalar(m[k]), input, f)})
	}
	return out
}

func podSources(c *contract, args map[string]resolved, pod map[string]any) []podSource {
	out := []podSource{{annotations: sortedPairs(obj(pod["annotations"]), "", nil), labels: sortedPairs(obj(pod["labels"]), "", nil)}}
	for _, n := range c.varOrder {
		if r, ok := args[n]; ok && r.kind == "injected" {
			s := obj(r.fields)
			out = append(out, podSource{input: n, annotations: sortedPairs(obj(s["podAnnotations"]), n, nil), labels: sortedPairs(obj(s["podLabels"]), n, nil)})
		}
	}
	for _, n := range c.fileOrder {
		if r, ok := args[n]; ok && r.kind == "injected" {
			f := c.files[n]
			s := obj(r.fields)
			out = append(out, podSource{input: n, file: &f, annotations: sortedPairs(obj(s["podAnnotations"]), n, &f), labels: sortedPairs(obj(s["podLabels"]), n, &f)})
		}
	}
	return out
}

func podProblems(sources []podSource) []string {
	var out []string
	for _, s := range sources {
		for _, fm := range []struct {
			field string
			pairs [][2]string
		}{{"podAnnotations", s.annotations}, {"podLabels", s.labels}} {
			what := "annotation"
			if fm.field == "podLabels" {
				what = "label"
			}
			for _, kv := range fm.pairs {
				k, v := kv[0], kv[1]
				switch {
				case placeholderRe.MatchString(k) || placeholderRe.MatchString(v):
					switch {
					case s.input == "":
						out = append(out, fmt.Sprintf("%s %s: uses a placeholder, which only an injected input's own podAnnotations and podLabels can", fm.field, k))
					case s.file != nil:
						out = append(out, fmt.Sprintf("%s: %s %s: uses a placeholder this input does not define", s.input, fm.field, k))
					default:
						out = append(out, fmt.Sprintf("%s: %s %s: uses {path}, {dir} or {file}, which only a file input defines; a variable has {input}", s.input, fm.field, k))
					}
				case !qualifiedRe.MatchString(k) || !qualifiedLenRe.MatchString(k):
					if s.input == "" {
						out = append(out, fmt.Sprintf("%s: key %q is not %s", fm.field, k, qualifiedRule))
					} else {
						out = append(out, fmt.Sprintf("%s: pod %s key %q is not %s", s.input, what, k, qualifiedRule))
					}
				case fm.field == "podLabels" && !labelValueRe.MatchString(v):
					if s.input == "" {
						out = append(out, fmt.Sprintf("podLabels %s: value %q is not a label value: %s", k, v, labelRule))
					} else {
						out = append(out, fmt.Sprintf("%s: pod label %s: value %q is not a label value: %s", s.input, k, v, labelRule))
					}
				}
			}
		}
	}
	// Two sources that set one key to different values (#PodMetadataConflicts).
	for _, field := range []string{"Annotations", "Labels"} {
		seen := map[string][2]string{} // key -> value, source label
		for _, s := range sources {
			pairs := s.annotations
			if field == "Labels" {
				pairs = s.labels
			}
			who := s.input
			if who == "" {
				who = "the shared podMetadata." + strings.ToLower(field)
			}
			for _, kv := range pairs {
				first, ok := seen[kv[0]]
				if !ok {
					seen[kv[0]] = [2]string{kv[1], who}
					continue
				}
				if first[0] != kv[1] {
					a, b := first[1], who
					if b < a {
						a, b = b, a
					}
					out = append(out, fmt.Sprintf("pod%s %s: set to different values by %s and %s", field, kv[0], a, b))
				}
			}
		}
	}
	return out
}

func render(c *contract, args map[string]resolved, overlayValues map[string]map[string]any, pod map[string]any) rendered {
	r := rendered{podAnnotations: map[string]string{}, podLabels: map[string]string{}}
	for _, n := range c.varOrder {
		if a, ok := args[n]; ok {
			r.env = append(r.env, renderVar(n, c.vars[n], a)...)
		}
	}
	var files []fileParts
	for _, n := range c.fileOrder {
		if a, ok := args[n]; ok {
			files = append(files, renderFile(c.name, n, c.files[n], a))
		}
	}
	for _, f := range files {
		r.env = append(r.env, f.env...)
		r.volumes = append(r.volumes, f.volumes...)
		r.volumeMounts = append(r.volumeMounts, f.volumeMounts...)
		r.configMaps = append(r.configMaps, f.configMaps...)
		r.restartTriggers = append(r.restartTriggers, f.restartTriggers...)
	}
	for _, n := range c.overlayOrder {
		if values, ok := overlayValues[n]; ok {
			cm, vol, mount := renderOverlay(c, n, values)
			r.configMaps = append(r.configMaps, cm)
			r.volumes = append(r.volumes, vol)
			r.volumeMounts = append(r.volumeMounts, mount)
		}
	}
	for _, s := range podSources(c, args, pod) {
		for _, kv := range s.annotations {
			r.podAnnotations[kv[0]] = kv[1]
		}
		for _, kv := range s.labels {
			r.podLabels[kv[0]] = kv[1]
		}
	}
	return r
}

// ---- Checks ----

var (
	emptyRoot     string
	emptyRootOnce sync.Once
)

// noFiles is a file root holding nothing, so value checks never read the
// deploying machine's files.
func noFiles() string {
	emptyRootOnce.Do(func() { emptyRoot, _ = os.MkdirTemp("", "docuconf-") })
	return emptyRoot
}

// collect is a slog handler that keeps the SDK's warnings.
type collect struct{ msgs *[]string }

func (h collect) Enabled(_ context.Context, l slog.Level) bool { return l >= slog.LevelWarn }
func (h collect) Handle(_ context.Context, r slog.Record) error {
	*h.msgs = append(*h.msgs, r.Message)
	return nil
}
func (h collect) WithAttrs([]slog.Attr) slog.Handler { return h }
func (h collect) WithGroup(string) slog.Handler      { return h }

// sdkCheck runs the Go SDK on an environment and file root, and returns the
// violations of the inputs keep accepts, and the warnings.
func sdkCheck(c *contract, env map[string]string, root string, keep func(docuconf.Violation) bool) ([]string, []string) {
	var warnings []string
	_, err := docuconf.LoadContract(c.forSDK, docuconf.Options{
		Environment:    env,
		FileRoot:       root,
		TerminationLog: "-",
		Logger:         slog.New(collect{&warnings}),
	})
	var problems []string
	var ve *docuconf.ValidationError
	if errors.As(err, &ve) {
		for _, v := range ve.Violations {
			if keep(v) {
				problems = append(problems, v.String())
			}
		}
	} else if err != nil {
		problems = append(problems, err.Error())
	}
	return problems, warnings
}

// valueProblems are a literal's problems, as the app would report them at boot.
func valueProblems(c *contract, name string, x any, suffix string) ([]string, []string) {
	v := c.vars[name]
	// What the SDK cannot see in the rendered text: precision a duration's
	// encoding drops, and an empty list, which renders as an unset variable.
	if d, ok := x.(string); ok && v.Type == "duration" && durationRe.MatchString(d) && v.Encoding != "" && v.Encoding != "go" {
		if _, ns := durationParts(d); ns != 0 {
			return []string{fmt.Sprintf("%s: %s is finer than a millisecond, which the %s encoding cannot carry (invalid_type)%s", name, d, v.Encoding, suffix)}, nil
		}
	}
	if l, ok := x.([]any); ok && v.Type == "list" && len(l) == 0 {
		if v.MinItems != nil && *v.MinItems > 0 {
			return []string{fmt.Sprintf("%s: must have at least %d items, has 0 (too_few_items)%s", name, *v.MinItems, suffix)}, nil
		}
		return nil, nil
	}
	env := map[string]string{}
	for _, e := range wireEntries(name, v, x) {
		env[e.name] = e.value
	}
	problems, warnings := sdkCheck(c, env, noFiles(), func(p docuconf.Violation) bool {
		return p.Input == name && p.Code != "missing_required"
	})
	for i := range problems {
		problems[i] += suffix
	}
	var mine []string
	for _, w := range warnings {
		if strings.HasPrefix(w, name+" ") || strings.HasPrefix(w, name+":") || strings.Contains(w, " "+name+" ") {
			mine = append(mine, w)
		}
	}
	return problems, mine
}

// inlineProblems are inline file content's problems, as the app would
// report them at boot.
func inlineProblems(c *contract, name, content string) []string {
	f := c.files[name]
	root, err := os.MkdirTemp("", "docuconf-")
	if err != nil {
		return []string{fmt.Sprintf("%s: %v", name, err)}
	}
	defer os.RemoveAll(root)
	file := filepath.Join(root, filepath.FromSlash(f.Path))
	if err := os.MkdirAll(filepath.Dir(file), 0o755); err != nil {
		return []string{fmt.Sprintf("%s: %v", name, err)}
	}
	if err := os.WriteFile(file, []byte(content), 0o644); err != nil {
		return []string{fmt.Sprintf("%s: %v", name, err)}
	}
	problems, _ := sdkCheck(c, map[string]string{}, root, func(p docuconf.Violation) bool { return p.Input == name })
	return problems
}

func varSources(v contractVar) []string {
	if isSecret(v) {
		return []string{"secretKeyRef", "injected"}
	}
	s := []string{"value"}
	if v.Type != "list" {
		s = append(s, "configMapKeyRef")
	}
	if v.Type == "string" {
		s = append(s, "fieldRef")
	}
	if v.Type == "int" {
		s = append(s, "resourceFieldRef")
	}
	return append(s, "injected")
}

func fileSources(f contractFile) []string {
	if f.Secret {
		if f.Type == "tls" {
			return []string{"secret", "certificate", "csi", "injected"}
		}
		return []string{"secret", "csi", "injected"}
	}
	var s []string
	if f.Type != "binary" {
		s = append(s, "inline")
	}
	s = append(s, "configMap", "secret")
	if f.Type == "tls" {
		s = append(s, "certificate")
	}
	return append(s, "csi", "image", "injected")
}

func orList(xs []string) string {
	if len(xs) < 2 {
		return strings.Join(xs, "")
	}
	return strings.Join(xs[:len(xs)-1], ", ") + " or " + xs[len(xs)-1]
}

func has(xs []string, x string) bool {
	for _, y := range xs {
		if y == x {
			return true
		}
	}
	return false
}

func deprecatedWarning(n string, d *deprecation) string {
	by := ""
	if d.ReplacedBy != "" && !strings.Contains(d.Message, d.ReplacedBy) {
		by = " (replaced by " + d.ReplacedBy + ")"
	}
	return fmt.Sprintf("%s is deprecated: %s%s", n, d.Message, by)
}

func (c *contract) profileSupplies(n string) bool {
	if c.profiles == nil {
		return false
	}
	for _, m := range c.profiles.Defaults {
		if _, ok := m[n]; ok {
			return true
		}
	}
	return false
}

func (c *contract) overlayReason(n, o string) string {
	v, ok := c.vars[n]
	switch {
	case !ok:
		return fmt.Sprintf("is not declared in the contract (check the spelling; in overlay %s)", o)
	case isSecret(v):
		return fmt.Sprintf("is secret, so it cannot go in overlay %s (a ConfigMap); supply it in the environment as a secretKeyRef or injected", o)
	case v.ConfigKey == "":
		return fmt.Sprintf("has no configKey in the contract, so overlay %s has nowhere to put it", o)
	case c.profiles != nil && c.profiles.Selector == n:
		return fmt.Sprintf("is the profile selector, which only the environment can set, not overlay %s", o)
	case len(strings.Split(v.ConfigKey, c.overlays[o].KeySeparator)) > 8:
		return fmt.Sprintf("configKey %s is nested deeper than 8 levels", v.ConfigKey)
	}
	return ""
}

// overlayTypeProblem is an overlay value of the wrong native type, with
// vet's message; overlays keep types that env text loses.
func overlayTypeProblem(v contractVar, x any) string {
	got := "got " + marshal(x)
	isInt := func(x any) bool {
		switch n := x.(type) {
		case int:
			return true
		case float64:
			return n == float64(int64(n))
		}
		return false
	}
	switch v.Type {
	case "int":
		if !isInt(x) {
			return "expected an integer, " + got
		}
	case "float":
		switch x.(type) {
		case int, float64:
		default:
			return "expected a number, " + got
		}
	case "bool":
		if _, ok := x.(bool); !ok {
			return "expected true or false, " + got
		}
	case "json":
	case "list":
		l, ok := x.([]any)
		for _, i := range l {
			if v.Items == "int" && !isInt(i) {
				ok = false
			}
			if _, s := i.(string); v.Items != "int" && !s {
				ok = false
			}
		}
		if !ok {
			items := v.Items
			if items == "" {
				items = "string"
			}
			return fmt.Sprintf("expected a list of %ss, %s", items, got)
		}
	case "url":
		if _, ok := x.(string); !ok {
			return "expected a URL string, " + got
		}
	default:
		if _, ok := x.(string); !ok {
			return "expected a string, " + got
		}
	}
	return ""
}

func certificateProblems(n string, f contractFile, s map[string]any) []string {
	var out []string
	if names, ok := s["dnsNames"].([]any); ok {
		for _, d := range f.DNSNames {
			wildcard := ""
			if i := strings.Index(d, "."); i >= 0 {
				wildcard = "*" + d[i:]
			}
			found := false
			for _, x := range names {
				found = found || x == d || x == wildcard
			}
			if !found {
				out = append(out, fmt.Sprintf("%s: certificate does not cover %s", n, d))
			}
		}
	}
	if alg := str(obj(s["privateKey"]), "algorithm"); alg != "" && len(f.KeyAlgorithms) > 0 && !has(f.KeyAlgorithms, alg) {
		out = append(out, fmt.Sprintf("%s: certificate key algorithm %s is not one of %s", n, alg, strings.Join(f.KeyAlgorithms, ", ")))
	}
	for _, field := range []string{"duration", "renewBefore"} {
		if x := str(s, field); x != "" && !durationRe.MatchString(x) {
			out = append(out, fmt.Sprintf("%s: certificate.%s %q is not a duration such as 1m30s", n, field, x))
		}
	}
	if rb := str(s, "renewBefore"); f.MinRemaining != "" && durationRe.MatchString(rb) && durationLess(rb, f.MinRemaining) {
		out = append(out, fmt.Sprintf("%s: certificate renewBefore %s is less than minRemaining %s, so the app could see a certificate with too little time left", n, rb, f.MinRemaining))
	}
	return out
}

// inputs are a component's arguments: each input's source, by name.
type inputs map[string]source

func (in inputs) set(name string, s sourcer) {
	if s != nil {
		in[name] = s.docuconfSource()
	}
}

// structureProblems are the checks that need no resolved Input: which
// sources are set, inline content, overlays, and anything else written as
// a literal.
func structureProblems(c *contract, args inputs, overlayValues map[string]map[string]any, pod *PodMetadata) ([]string, []string) {
	var problems, warnings []string
	inOverlay := func(n string) []string {
		var out []string
		for _, o := range c.overlayOrder {
			if _, ok := overlayValues[o][n]; ok {
				out = append(out, o)
			}
		}
		return out
	}
	for _, n := range c.varOrder {
		v := c.vars[n]
		s, ok := args[n]
		srcs := varSources(v)
		if !ok {
			if v.Required && len(inOverlay(n)) == 0 && !c.profileSupplies(n) {
				problems = append(problems, n+": required, but not set (missing_required)")
			}
			continue
		}
		if !has(srcs, s.kind) {
			problems = append(problems, fmt.Sprintf("%s: set exactly one of %s", n, orList(srcs)))
			continue
		}
		f := obj(s.fields)
		switch s.kind {
		case "injected":
			if !providerRe.MatchString(str(f, "provider")) {
				problems = append(problems, n+": injected.provider must name the injector as a lowercase label, such as bank-vaults")
			}
			if _, ref := f["ref"]; ref && (v.Type == "list" || v.Type == "keySet") && v.Encoding == "indexed" {
				problems = append(problems, n+": an indexed list is spread over NAME__0, NAME__1, …, so one injected reference cannot carry it; let the injector set the variables, without ref")
			}
		case "fieldRef":
			if p := str(f, "fieldPath"); !fieldPathRe.MatchString(p) {
				problems = append(problems, fmt.Sprintf("%s: fieldRef.fieldPath %q is not a Downward API field", n, p))
			}
		case "resourceFieldRef":
			if r := str(f, "resource"); !has(containerFields, r) {
				problems = append(problems, fmt.Sprintf("%s: resourceFieldRef.resource %q is not a container resource", n, r))
			}
		}
		if v.Deprecated != nil && s.kind != "value" {
			warnings = append(warnings, deprecatedWarning(n, v.Deprecated))
		}
		// A plain literal is checked now, with the others, so every
		// problem is reported at once; an Output is checked when it
		// resolves.
		if s.kind == "value" {
			if x, known := plain(s.fields); known {
				p, w := valueProblems(c, n, x, "")
				problems = append(problems, p...)
				warnings = append(warnings, w...)
			}
		}
		for _, o := range inOverlay(n) {
			problems = append(problems, fmt.Sprintf("%s: is set both in the environment and in overlay %s; set it in one place (the environment would win)", n, o))
		}
	}

	for _, n := range c.fileOrder {
		f := c.files[n]
		s, ok := args[n]
		srcs := fileSources(f)
		if !ok {
			if f.Required {
				problems = append(problems, fmt.Sprintf("%s: is a required file input; set one of %s", n, orList(srcs)))
			}
			continue
		}
		if !has(srcs, s.kind) {
			hint := ""
			if f.Secret {
				hint = " (a secret file comes from a secret store)"
			}
			problems = append(problems, fmt.Sprintf("%s: set exactly one of %s%s", n, orList(srcs), hint))
			continue
		}
		if f.Deprecated != nil {
			warnings = append(warnings, deprecatedWarning(n, f.Deprecated))
		}
		m := obj(s.fields)
		fileName := path.Base(f.Path)
		switch s.kind {
		case "inline":
			x, known := plain(s.fields)
			if !known {
				problems = append(problems, n+": inline content is written into the platform's code; give it as a value, not an Output")
				continue
			}
			if _, text := x.(string); !text && f.Type != "config" {
				problems = append(problems, fmt.Sprintf("%s: inline content must be text for a %s file", n, f.Type))
				continue
			}
			problems = append(problems, inlineProblems(c, n, inlineContent(f, x))...)
		case "configMap", "secret":
			_, key := m["key"]
			if f.Type != "tls" && !key {
				problems = append(problems, fmt.Sprintf("%s: %s.key is required: name the key that holds %s", n, s.kind, fileName))
			}
			if f.Type == "tls" && key {
				problems = append(problems, n+": a tls input mounts the whole Secret; remove secret.key")
			}
		case "injected":
			if !providerRe.MatchString(str(m, "provider")) {
				problems = append(problems, n+": injected.provider must name the injector as a lowercase label, such as bank-vaults")
			}
		case "image":
			if p := str(m, "pullPolicy"); p != "" && !has([]string{"Always", "IfNotPresent", "Never"}, p) {
				problems = append(problems, fmt.Sprintf("%s: image.pullPolicy %q is not one of Always, IfNotPresent, Never", n, p))
			}
		case "certificate":
			if x, known := plain(s.fields); known {
				problems = append(problems, certificateProblems(n, f, obj(x))...)
			}
		}
	}

	for _, o := range sortedKeys(overlayValues) {
		values := overlayValues[o]
		if _, ok := c.overlays[o]; !ok {
			problems = append(problems, fmt.Sprintf("OverlayValues[%q]: is not an overlay in the contract", o))
			continue
		}
		for _, n := range sortedKeys(values) {
			x := normalize(values[n])
			if why := c.overlayReason(n, o); why != "" {
				problems = append(problems, n+": "+why)
				continue
			}
			if m, ok := x.(map[string]any); ok {
				ref := false
				for _, k := range []string{"secretKeyRef", "configMapKeyRef", "fieldRef", "resourceFieldRef", "injected"} {
					_, isRef := m[k]
					ref = ref || isRef
				}
				if ref {
					problems = append(problems, fmt.Sprintf("%s: overlay %s holds values, not references; give a literal, or supply the reference in the environment", n, o))
					continue
				}
			}
			if t := overlayTypeProblem(c.vars[n], x); t != "" {
				problems = append(problems, fmt.Sprintf("%s: %s (in overlay %s)", n, t, o))
				continue
			}
			p, w := valueProblems(c, n, x, " (in overlay "+o+")")
			problems = append(problems, p...)
			warnings = append(warnings, w...)
		}
	}
	for _, n := range c.varOrder {
		if len(inOverlay(n)) > 1 {
			problems = append(problems, n+": is set in more than one overlay; set it in one place")
		}
	}
	// Pod metadata is always a literal in Go: check it now.
	if len(problems) == 0 {
		lit := map[string]resolved{}
		for n, s := range args {
			if s.kind == "injected" {
				x, _ := plain(s.fields)
				lit[n] = resolved{s.kind, x}
			}
		}
		problems = append(problems, podProblems(podSources(c, lit, podMap(pod)))...)
	}
	return problems, warnings
}

func podMap(p *PodMetadata) map[string]any {
	if p == nil {
		return map[string]any{}
	}
	return map[string]any{"annotations": stringMap(p.Annotations), "labels": stringMap(p.Labels)}
}

func sortedKeys[V any](m map[string]V) []string {
	out := make([]string, 0, len(m))
	for k := range m {
		out = append(out, k)
	}
	sort.Strings(out)
	return out
}

// ---- The component ----

type outputs struct {
	env             corev1.EnvVarArrayOutput
	volumes         corev1.VolumeArrayOutput
	volumeMounts    corev1.VolumeMountArrayOutput
	configMaps      []ConfigMapSpec
	restartTriggers pulumi.ArrayOutput
	podAnnotations  pulumi.StringMapOutput
	podLabels       pulumi.StringMapOutput
	bindings        map[string]Binding
	checked         pulumi.BoolOutput
}

// build checks and renders a component's arguments. Problems that need no
// resolved Input are returned at once; a value's problems fail every output
// when it resolves.
func build(ctx *pulumi.Context, self pulumi.Resource, args inputs, overlayValues map[string]map[string]any, pod *PodMetadata) (*outputs, error) {
	c, err := theContract()
	if err != nil {
		return nil, err
	}
	component := c.name + " config"
	for n := range args {
		if _, v := c.vars[n]; !v {
			if _, f := c.files[n]; !f {
				return nil, &ConfigViolation{component, []string{n + ": is not declared in the contract"}}
			}
		}
	}
	problems, warnings := structureProblems(c, args, overlayValues, pod)
	if len(problems) > 0 {
		return nil, &ConfigViolation{component, problems}
	}
	ctxLog := func(w string) { ctx.Log.Warn(w, &pulumi.LogArgs{Resource: self}) }
	for _, w := range warnings {
		ctxLog(w)
	}

	// Each source resolves on its own; a value that is an Output is checked
	// when it does, so a bad one that is known at preview fails the preview
	// even when another value is not known yet.
	names := sortedKeys(args)
	outs := make([]any, len(names))
	for i, n := range names {
		n, s := n, args[n]
		_, known := plain(s.fields)
		later := s.kind == "value" && !known
		outs[i] = pulumi.ToOutput(s.fields).ApplyT(func(x any) (any, error) {
			x = normalize(x)
			if later {
				p, w := valueProblems(c, n, x, "")
				if len(p) > 0 {
					return nil, &ConfigViolation{component, p}
				}
				for _, m := range w {
					ctxLog(m)
				}
			}
			return x, nil
		})
	}
	all := pulumi.All(outs...).ApplyT(func(xs []any) (any, error) {
		res := map[string]resolved{}
		for i, n := range names {
			res[n] = resolved{args[n].kind, xs[i]}
		}
		if p := podProblems(podSources(c, res, podMap(pod))); len(p) > 0 {
			return nil, &ConfigViolation{component, p}
		}
		return render(c, res, overlayValues, podMap(pod)), nil
	})

	// ConfigMaps hold only literals, so they are known now, and the program
	// can declare one resource for each.
	lit := map[string]resolved{}
	for n, s := range args {
		if s.kind == "inline" {
			x, _ := plain(s.fields)
			lit[n] = resolved{s.kind, x}
		}
	}
	configMaps := render(c, lit, overlayValues, nil).configMaps

	bindings := map[string]Binding{}
	for _, n := range c.varOrder {
		b := Binding{}
		if s, ok := args[n]; ok {
			b = Binding{true, s.kind}
		} else {
			for _, o := range c.overlayOrder {
				if _, ok := overlayValues[o][n]; ok {
					b = Binding{true, "overlay:" + o}
					break
				}
			}
		}
		bindings[n] = b
	}
	for _, n := range c.fileOrder {
		b := Binding{}
		if s, ok := args[n]; ok {
			b = Binding{true, s.kind}
		}
		bindings[n] = b
	}

	return &outputs{
		env:     all.ApplyT(func(x any) []corev1.EnvVar { return toEnv(x.(rendered).env) }).(corev1.EnvVarArrayOutput),
		volumes: all.ApplyT(func(x any) []corev1.Volume { return toVolumes(x.(rendered).volumes) }).(corev1.VolumeArrayOutput),
		volumeMounts: all.ApplyT(func(x any) []corev1.VolumeMount {
			return toVolumeMounts(x.(rendered).volumeMounts)
		}).(corev1.VolumeMountArrayOutput),
		configMaps: configMaps,
		restartTriggers: all.ApplyT(func(x any) []any {
			r := x.(rendered)
			out := make([]any, len(r.restartTriggers))
			for i, t := range r.restartTriggers {
				out[i] = map[string]any{"kind": t.Kind, "name": t.Name}
			}
			return out
		}).(pulumi.ArrayOutput),
		podAnnotations: all.ApplyT(func(x any) map[string]string { return x.(rendered).podAnnotations }).(pulumi.StringMapOutput),
		podLabels:      all.ApplyT(func(x any) map[string]string { return x.(rendered).podLabels }).(pulumi.StringMapOutput),
		bindings:       bindings,
		checked:        all.ApplyT(func(any) bool { return true }).(pulumi.BoolOutput),
	}, nil
}

// ---- The kubernetes provider's types ----

func ptr[T any](x T) *T { return &x }

func toEnv(env []map[string]any) []corev1.EnvVar {
	out := make([]corev1.EnvVar, 0, len(env))
	for _, e := range env {
		ev := corev1.EnvVar{Name: str(e, "name")}
		if v, ok := e["value"].(string); ok {
			ev.Value = ptr(v)
		}
		if from := obj(e["valueFrom"]); from != nil {
			src := &corev1.EnvVarSource{}
			if r := obj(from["secretKeyRef"]); r != nil {
				src.SecretKeyRef = &corev1.SecretKeySelector{Name: ptr(str(r, "name")), Key: str(r, "key")}
			}
			if r := obj(from["configMapKeyRef"]); r != nil {
				src.ConfigMapKeyRef = &corev1.ConfigMapKeySelector{Name: ptr(str(r, "name")), Key: str(r, "key")}
			}
			if r := obj(from["fieldRef"]); r != nil {
				src.FieldRef = &corev1.ObjectFieldSelector{FieldPath: str(r, "fieldPath")}
			}
			if r := obj(from["resourceFieldRef"]); r != nil {
				sel := &corev1.ResourceFieldSelector{Resource: str(r, "resource")}
				if d := str(r, "divisor"); d != "" {
					sel.Divisor = ptr(d)
				}
				if cn := str(r, "containerName"); cn != "" {
					sel.ContainerName = ptr(cn)
				}
				src.ResourceFieldRef = sel
			}
			ev.ValueFrom = src
		}
		out = append(out, ev)
	}
	return out
}

func keyToPaths(x any) []corev1.KeyToPath {
	l, _ := x.([]any)
	out := make([]corev1.KeyToPath, 0, len(l))
	for _, i := range l {
		m := obj(i)
		out = append(out, corev1.KeyToPath{Key: str(m, "key"), Path: str(m, "path")})
	}
	return out
}

func toVolumes(vols []map[string]any) []corev1.Volume {
	out := make([]corev1.Volume, 0, len(vols))
	for _, v := range vols {
		vol := corev1.Volume{Name: str(v, "name")}
		if cm := obj(v["configMap"]); cm != nil {
			vol.ConfigMap = &corev1.ConfigMapVolumeSource{Name: ptr(str(cm, "name")), DefaultMode: ptr(cm["defaultMode"].(int)), Items: keyToPaths(cm["items"])}
		}
		if s := obj(v["secret"]); s != nil {
			src := &corev1.SecretVolumeSource{SecretName: ptr(str(s, "secretName")), DefaultMode: ptr(s["defaultMode"].(int))}
			if s["items"] != nil {
				src.Items = keyToPaths(s["items"])
			}
			vol.Secret = src
		}
		if c := obj(v["csi"]); c != nil {
			vol.Csi = &corev1.CSIVolumeSource{Driver: str(c, "driver"), ReadOnly: ptr(true), VolumeAttributes: map[string]string{"secretProviderClass": str(obj(c["volumeAttributes"]), "secretProviderClass")}}
		}
		if im := obj(v["image"]); im != nil {
			src := &corev1.ImageVolumeSource{Reference: ptr(str(im, "reference"))}
			if p := str(im, "pullPolicy"); p != "" {
				src.PullPolicy = ptr(p)
			}
			vol.Image = src
		}
		out = append(out, vol)
	}
	return out
}

func toVolumeMounts(ms []map[string]any) []corev1.VolumeMount {
	out := make([]corev1.VolumeMount, 0, len(ms))
	for _, m := range ms {
		out = append(out, corev1.VolumeMount{Name: str(m, "name"), MountPath: str(m, "mountPath"), ReadOnly: ptr(true)})
	}
	return out
}
