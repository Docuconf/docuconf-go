var durationRe = regexp.MustCompile(`^([0-9]+(ns|us|ms|s|m|h))+$`)
var durationPart = regexp.MustCompile(`([0-9]+)(ns|us|ms|s|m|h)`)

// durationParts is a duration as whole milliseconds and the nanoseconds
// left over.
func durationParts(d string) (int64, int64) {
	var ms, ns int64
	for _, m := range durationPart.FindAllStringSubmatch(d, -1) {
		n, _ := strconv.ParseInt(m[1], 10, 64)
		switch m[2] {
		case "ns":
			ns += n
		case "us":
			ns += n * 1000
		case "ms":
			ms += n
		case "s":
			ms += n * 1000
		case "m":
			ms += n * 60000
		case "h":
			ms += n * 3600000
		}
	}
	return ms + ns/1e6, ns % 1e6
}

func durationLess(a, b string) bool {
	am, an := durationParts(a)
	bm, bn := durationParts(b)
	return am < bm || (am == bm && an < bn)
}

// renderDuration is a duration in its encoding (#RenderDuration).
func renderDuration(d, encoding string) string {
	if encoding == "" || encoding == "go" || !durationRe.MatchString(d) {
		return d
	}
	ms, _ := durationParts(d)
	secs, frac := ms/1000, ms%1000
	fracStr := ""
	if frac != 0 {
		fracStr = "." + strings.TrimRight(fmt.Sprintf("%03d", frac), "0")
	}
	switch encoding {
	case "seconds":
		return fmt.Sprintf("%d%s", secs, fracStr)
	case "iso8601":
		return fmt.Sprintf("PT%d%sS", secs, fracStr)
	}
	days := ""
	if secs >= 86400 {
		days = fmt.Sprintf("%d.", secs/86400)
	}
	return fmt.Sprintf("%s%02d:%02d:%02d%s", days, (secs%86400)/3600, (secs%3600)/60, secs%60, fracStr)
}

// marshal is JSON as #Render writes it: compact, <, > and & as they are,
// U+2028 and U+2029 escaped.
func marshal(x any) string {
	var b bytes.Buffer
	enc := json.NewEncoder(&b)
	enc.SetEscapeHTML(false)
	enc.Encode(x)
	return strings.TrimSuffix(b.String(), "\n")
}

func scalar(x any) string {
	switch v := x.(type) {
	case string:
		return v
	case float64:
		return strconv.FormatFloat(v, 'f', -1, 64)
	case nil:
		return ""
	}
	return fmt.Sprint(x)
}

