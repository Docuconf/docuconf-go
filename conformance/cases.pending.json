{
  "cases": [
    {
      "id": "required_if/conditions off, conditional inputs optional",
      "source": "pending/required_if.yaml",
      "requires": [
        "files",
        "profiles",
        "required-if"
      ],
      "contract": {
        "apiVersion": "docuconf.dev/v1alpha1",
        "files": {
          "allowlist": {
            "name": "allowlist",
            "description": "Client names allowed over TLS",
            "required": false,
            "secret": false,
            "path": "/etc/relay/allowlist/allow.txt",
            "reload": "restart",
            "requiredIf": {
              "TLS_ENABLED": true
            },
            "type": "text"
          }
        },
        "kind": "ConfigContract",
        "metadata": {
          "name": "conformance-required-if",
          "generator": {
            "language": "go",
            "sdk": "docuconf-conformance",
            "version": "1"
          }
        },
        "profiles": {
          "selector": "APP_ENV",
          "default": "development",
          "defaults": {
            "production": {
              "TLS_ENABLED": true
            }
          }
        },
        "vars": {
          "ACME_EMAIL": {
            "name": "ACME_EMAIL",
            "description": "Contact address for certificate renewal",
            "required": false,
            "secret": false,
            "requiredIf": {
              "PORT": 443
            },
            "type": "string"
          },
          "APP_ENV": {
            "name": "APP_ENV",
            "description": "Which profile file the app loads",
            "required": false,
            "secret": false,
            "type": "string",
            "default": "development"
          },
          "LOG_FORMAT": {
            "name": "LOG_FORMAT",
            "description": "Log output format",
            "required": false,
            "secret": false,
            "type": "enum",
            "values": [
              "text",
              "json"
            ],
            "default": "text"
          },
          "LOG_SCHEMA_URL": {
            "name": "LOG_SCHEMA_URL",
            "description": "JSON schema the structured logs follow",
            "required": false,
            "secret": false,
            "requiredIf": {
              "LOG_FORMAT": "json"
            },
            "type": "url"
          },
          "PORT": {
            "name": "PORT",
            "description": "Port to listen on",
            "required": false,
            "secret": false,
            "type": "int",
            "default": 443
          },
          "TLS_CLIENT_CA_SUBJECT": {
            "name": "TLS_CLIENT_CA_SUBJECT",
            "description": "Subject of the CA that signs client certificates",
            "required": false,
            "secret": false,
            "requiredIf": {
              "TLS_ENABLED": true
            },
            "type": "string"
          },
          "TLS_ENABLED": {
            "name": "TLS_ENABLED",
            "description": "Serve HTTPS instead of HTTP",
            "required": false,
            "secret": false,
            "type": "bool",
            "default": false
          }
        }
      },
      "env": {
        "PORT": "8080"
      },
      "expect": {
        "ACME_EMAIL": null,
        "APP_ENV": "development",
        "LOG_FORMAT": "text",
        "LOG_SCHEMA_URL": null,
        "PORT": 8080,
        "TLS_CLIENT_CA_SUBJECT": null,
        "TLS_ENABLED": false,
        "allowlist": null
      }
    },
